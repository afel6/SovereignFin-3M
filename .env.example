# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL (docker compose). Use the same passwords inside the URLs below.
POSTGRES_PASSWORD=
SF_OWNER_PASSWORD=
SF_READER_PASSWORD=
# Query-time, read-only role.
DATABASE_URL=postgresql://sf_reader:CHANGE_ME@127.0.0.1:5432/sovereignfin
# Offline loaders and writers only.
DATABASE_URL_OWNER=postgresql://sf_owner:CHANGE_ME@127.0.0.1:5432/sovereignfin
# Database rebuild only.
DATABASE_URL_ADMIN=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres

# Qdrant (docker compose).
QDRANT_URL=http://127.0.0.1:6333

# LLM: nvidia | openai_compatible | stub
SF_LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
# openai_compatible provider only.
SF_LLM_BASE_URL=
SF_LLM_API_KEY=
# Empty = built-in default model for the provider.
SF_LLM_FAST_MODEL=
SF_LLM_STRONG_MODEL=
# Empty = local mode not configured.
SF_LLM_LOCAL_MODEL=
OLLAMA_HOST=http://127.0.0.1:11434

# API base URL used by the UI and the evaluation scripts.
SF_API_BASE=http://127.0.0.1:8000
